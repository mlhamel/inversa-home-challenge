# Study areas: REGION_<NAME>=min_lon,min_lat,max_lon,max_lat (+ optional REGION_<NAME>_LABEL)
REGION_CALIFORNIA=-124.4,36.0,-115.4,42.0
# Legacy single-area fallback, used only when no REGION_* variable is set
#BBOX=-124.4,36.0,-115.4,42.0
# Local datalake root (/mnt/data on Cloud Run)
DATA_DIR=./.local_datalake
# NASA FIRMS area CSV API key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# OpenAQ v3 API key: https://explore.openaq.org/account
OPENAQ_API_KEY=
